# dependencies & build output
node_modules/
.next/
out/
dist/
build/

# environment / secrets
.env
.env.local
.env.production
.env.*.local

# database (SQLite lives on a persistent volume in prod — never commit it)
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# generated / uploaded runtime assets
# NOTE: keep these scoped — a bare "generated/" or "uploads/" also matches source
# dirs like app/api/generated and app/api/uploads and would silently exclude them
# from git. Dev uploads live under data/ (already ignored above); prod uploads
# live on the persistent volume (DATA_DIR), never in the repo.
public/generated/
tmp/
temp/

# OS junk
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# misc
.next-build/
.claude/
